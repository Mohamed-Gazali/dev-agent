# Copie ce fichier en ".env" puis remplis les valeurs. Ne commit JAMAIS le fichier .env.

# Fournisseur utilisé par défaut : gemini | groq | custom  (surchargé par --provider)
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=colle_ta_cle_ici
GEMINI_MODEL=gemini-3.8-flash

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=colle_ta_cle_ici
GROQ_MODEL=openai/gpt-oss-120b

# --- Autre API compatible OpenAI (provider "custom") ---
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=colle_ta_cle_ici
# LLM_MODEL=nom-du-modele
